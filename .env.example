# Copy to .env next to docker-compose.yml. Never commit .env.

# Your existing Suwayomi server, as seen from the KaviSeerr container.
SUWAYOMI_URL=http://192.168.1.10:4567

# Host folder that receives imported chapters. Mount the same folder in Kavita.
KAVISEERR_LIBRARY=/srv/media/manga/kaviseerr

# Host port for the web interface.
KAVISEERR_PORT=2512
