# Optional: copy to .env next to docker-compose.yml. Never commit .env.

# Folder that contains your Kavita libraries (mounted at /library).
KAVITA_LIBRARIES=/path/to/your/kavita/libraries

# Host port for the web interface.
BUNKO_PORT=2512

# Set to true when running behind a TLS-terminating reverse proxy (honors X-Forwarded-Proto
# for Secure session cookies and X-Forwarded-For for login rate limiting).
# BUNKO_TRUST_PROXY=true

# Force the Secure attribute on session cookies unconditionally (recommended for HTTPS-only deployments).
# BUNKO_SECURE_COOKIES=true

# Optional: deterministic first-start setup code (otherwise a random XXXX-XXXX-XXXX code is generated
# on first boot, logged once to stdout, and saved in /data/setup.code).
# BUNKO_SETUP_CODE=

# Optional: comma-separated LAN/Docker hosts (host, host:port, or CIDR) reachable by video extensions.
# BUNKO_VIDEO_ALLOWED_HOSTS=
